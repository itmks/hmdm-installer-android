<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_logo"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HMDM ADB Installer"
                        android:textColor="@color/header_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Wireless debugging · Device Owner"
                        android:textColor="@color/header_subtext"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Status koneksi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/txtConn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="Belum terhubung"
                    android:textColor="@color/header_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:textColor="@color/header_subtext"
                android:textSize="12sp" />
        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

            <!-- 1. Pair -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hmdm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Hmdm.Badge"
                            android:text="1" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Hmdm.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ADB Pair" />

                            <TextView
                                style="@style/Hmdm.CardHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="HP target: Opsi Developer › Wireless debugging › Pair device with pairing code" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hmdm.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="2"
                            android:hint="IP pairing">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtPairIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:digits="0123456789.:"
                                android:inputType="number"
                                android:minHeight="0dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:textSize="13sp"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hmdm.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtPairPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="number"
                                android:minHeight="0dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:textSize="13sp"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hmdm.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="2"
                            android:hint="Kode pairing">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtPairCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="number"
                                android:minHeight="0dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:textSize="13sp"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPair"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:minHeight="0dp"
                            android:textSize="13sp"
                            android:layout_weight="1"
                            android:text="Pair" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Connect -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hmdm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Hmdm.Badge"
                            android:text="2" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Hmdm.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ADB Connect" />

                            <TextView
                                style="@style/Hmdm.CardHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="IP dan port yang tampil di layar utama Wireless debugging" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hmdm.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="2"
                            android:hint="IP connect">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtConnIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:digits="0123456789.:"
                                android:inputType="number"
                                android:minHeight="0dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:textSize="13sp"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hmdm.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtConnPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="number"
                                android:minHeight="0dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:textSize="13sp"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDisconnect"
                            style="@style/Widget.Hmdm.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:minHeight="0dp"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="Disconnect" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnect"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:minHeight="0dp"
                            android:textSize="13sp"
                            android:layout_weight="1"
                            android:text="Connect" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. APK -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hmdm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Hmdm.Badge"
                            android:text="3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtApkTitle"
                                style="@style/Hmdm.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daftar APK" />

                            <TextView
                                style="@style/Hmdm.CardHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dipasang berurutan dari atas. Centang untuk menghapus." />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/apkList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/txtApkEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_empty"
                        android:gravity="center"
                        android:padding="22dp"
                        android:text="Belum ada APK. Klik &quot;Tambah APK&quot;."
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddApk"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:text="+ Tambah APK" 
                            android:minHeight="0dp"
                            android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemoveApk"
                            style="@style/Widget.Hmdm.Button.Danger"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="Hapus" 
                            android:minHeight="0dp"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearApk"
                            style="@style/Widget.Hmdm.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Kosongkan" 
                            android:minHeight="0dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Jalankan -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hmdm.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Hmdm.Badge"
                            android:text="4" />

                        <TextView
                            style="@style/Hmdm.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Jalankan" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstallOnly"
                            style="@style/Widget.Hmdm.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="Install Semua APK" 
                            android:minHeight="0dp"
                            android:autoSizeMaxTextSize="13sp"
                            android:autoSizeMinTextSize="9sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOwner"
                            style="@style/Widget.Hmdm.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Set Device Owner" 
                            android:minHeight="0dp"
                            android:autoSizeMaxTextSize="13sp"
                            android:autoSizeMinTextSize="9sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAll"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:text="Jalankan Semua" 
                            android:minHeight="0dp"
                            android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_note"
                        android:lineSpacingMultiplier="1.1"
                        android:padding="12dp"
                        android:text="Jalankan Semua: Pair › Connect › Install semua APK › Set Device Owner. Device owner hanya berhasil di HP baru / habis factory reset tanpa akun."
                        android:textColor="@color/text"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/txtStatus"
                    style="@style/Hmdm.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Log" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyLog"
                    style="@style/Widget.Hmdm.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="Salin" 
                            android:minHeight="0dp"
                            android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearLog"
                    style="@style/Widget.Hmdm.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="Bersihkan" 
                            android:minHeight="0dp"
                            android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/log_bg"
                android:nestedScrollingEnabled="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="@color/log_text"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="© 2026 PT. Sumber Alfaria Trijaya, Tbk - IT RZ01 Department · Version 3.0"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
